#!/bin/sh
# Git credential helper for the project repositories (configured in the
# image as `credential.helper = token`). Answers `get` with the token in
# $GIT_TOKEN_FILE (default /run/secrets/git_token) and $GIT_TOKEN_USER
# (default oauth2; a GitLab deploy token needs its own username). Without the
# file it answers nothing and git goes on without credentials. Never writes.
[ "$1" = get ] || exit 0
file=${GIT_TOKEN_FILE:-/run/secrets/git_token}
[ -r "$file" ] || exit 0
echo "username=${GIT_TOKEN_USER:-oauth2}"
echo "password=$(tr -d '\n' < "$file")"
